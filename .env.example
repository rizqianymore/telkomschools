# ==============================================================================
# KONFIGURASI APLIKASI & ENVIRONMENT SMK TELKOM JAKARTA
# ==============================================================================

# 1. Environment & Server Port
PORT=3000
NODE_ENV=development

# 2. Keamanan Sesi & Kriptografi Token (HMAC SHA-256)
# Ganti dengan string acak panjang di server produksi
SESSION_SECRET=telkom-schools-production-secure-key-2026

# 3. Kunci Proteksi Anti-Scraping AI Virtual Assistant
# Digunakan untuk menandatangani request dari client widget ke server endpoint
NEXT_PUBLIC_AI_CLIENT_SIGNATURE=telkom-schools-ai-client-v1

# 4. Konfigurasi AI API Engine
AI_API_ENDPOINT=https://api.overchat.ai/v1/chat/completions
# AI_API_KEY= (Opsional jika menggunakan penyedia OpenAI/Gemini/OverChat berbayar)

# 5. Database MySQL / MariaDB (Opsional untuk migrasi database nyata)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smk_telkom_jkt

# 6. Cloudflare Tunnel (Opsional jika menggunakan Cloudflare Zero Trust)
CLOUDFLARE_TUNNEL_TOKEN=
